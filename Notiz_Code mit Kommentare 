        </nav>

    <div class="container">
        <div id="home" class="home-section active">
            <h2 data-i18n="welcome">Willkommen bei RBTC</h2>
            <p data-i18n="intro">Kenneth E. Hagin ist der Autor von 110 Büchern, die in viele Sprachen übersetzt wurden. Mit seinem Radioprogramm, RHEMA USA erreicht Rhema mehr als 100 Länder.</p>
            <p data-i18n="foundation">Gründung: Als Bruder Hagin im Dienst unterwegs war, rief er oft nachts zu Gott: "Wie kann ich diese Botschaft zu deinem Volk bringen?" Ihm wurde klar, dass er Menschen trainieren musste, damit sie ausgehen und die Botschaft der Bibel lehrten.</p>
            <p data-i18n="graduates">Seit 1975 haben über 40.000 Studenten das RBTC USA absolviert.</p>
            <p data-i18n="presence">RBTC ist auf mehreren Kontinenten aktiv und zeigt seine Präsenz in verschiedenen Ländern:</p>
            <ul>
                <li data-i18n="americas">Amerika: 0 Länder</li>
                <li data-i18n="eame">EAME (Europa, Afrika, Naher Osten): 0 Länder</li>
                <li data-i18n="asia">Asien/Ozeanien: 0 Länder</li>
            </ul>
            </div>

        <div id="map-section" class="map-section">
            <div class="filter-container">
                <label for="continentFilter" data-i18n="filter-continent">Kontinent:</label>
                <select id="continentFilter" onchange="filterMap()">
                    <option value="all" data-i18n="filter-all">Alle</option>
                    <option value="Americas">Americas</option>
                    <option value="EAME">EAME</option>
                    <option value="Asia/Oceania">Asia/Oceania</option>
                    </select>
                <label for="countryFilter" data-i18n="filter-country">Land:</label>
                <select id="countryFilter" onchange="filterMap()">
                    <option value="all" data-i18n="filter-all">Alle</option>
                </select>
                <label for="showYellow" data-i18n="filter-preparing">In RBTC Vorbereitung anzeigen:</label>
                <input type="checkbox" id="showYellow" checked onchange="filterMap()">
                </div>
            <div id="mapContainer">
                <div id="map"></div>
                <div id="infoBox" class="info-box">
                    <h3 id="countryName"></h3>
                    <p><span data-i18n="info-continent">Kontinent</span>: <span id="continent"></span></p>
                    <p data-i18n="info-urls">URLs:</p>
                    <div id="countryUrls"></div>
                    </div>
                <div class="legend">
                    <div><span class="color-box" style="background-color: #ffcccc;"></span> <span data-i18n="legend-active">RBTC aktiv</span></div>
                    <div><span class="color-box" style="background-color: #ffff99;"></span> <span data-i18n="legend-preparing">In Vorbereitung RBTC</span></div>
                    </div>
            </div>
        </div>

        <div id="about" class="about-section">
            <h2 data-i18n="about-title">Zweck</h2>
            <p data-i18n="about-text">Der Zweck dieser Website ist es zu zeigen, wo RBTC aktiv ist und direkte Links zu den jeweiligen Online-Präsenzen der Länder bereitzustellen.</p>
            </div>
    </div>

    <footer>
        <p data-i18n="footer">© 2025 RBTC International Schools Map. Alle Rechte vorbehalten.</p>
        </footer>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>

    <script>
        // Globale Variablen
        let currentLanguage = 'de'; // Speichert die aktuell ausgewählte Sprache (Standard ist Deutsch).
        let rbtcCountriesData = []; // Ein Array, das die Daten der RBTC-Länder aus der CSV-Datei speichert.
        let geoJsonLayer; // Eine Variable, um das GeoJSON-Layer-Objekt der Karte zu speichern, sodass es später entfernt und aktualisiert werden kann.
        let geoJsonData; // Eine Variable, um die geladenen GeoJSON-Daten der Weltkarte zu speichern.

        // Ein Objekt, das die Übersetzungen für verschiedene Sprachen enthält.
        const translations = {
            de: { // Deutsche Übersetzungen
                "title": "RBTC Schools Map",
                "nav-home": "Home",
                "nav-map": "Karte",
                "nav-about": "Zweck",
                "welcome": "Willkommen bei RBTC",
                "intro": "Kenneth E. Hagin ist der Autor von 110 Büchern, die in viele Sprachen übersetzt wurden. Mit seinem Radioprogramm, RHEMA USA erreicht Rhema mehr als 100 Länder.",
                "foundation": "Gründung: Als Bruder Hagin im Dienst unterwegs war, rief er oft nachts zu Gott: \"Wie kann ich diese Botschaft zu deinem Volk bringen?\" Ihm wurde klar, dass er Menschen trainieren musste, damit sie ausgehen und die Botschaft der Bibel lehrten.",
                "graduates": "Seit 1975 haben über 40.000 Studenten das RBTC USA absolviert.",
                "presence": "RBTC ist auf mehreren Kontinenten aktiv und zeigt seine Präsenz in verschiedenen Ländern:",
                "americas": "Amerika: 0 Länder",
                "eame": "EAME (Europa, Afrika, Naher Osten): 0 Länder",
                "asia": "Asien/Ozeanien: 0 Länder",
                "filter-continent": "Kontinent:",
                "filter-country": "Land:",
                "filter-all": "Alle",
                "filter-preparing": "In RBTC Vorbereitung anzeigen:",
                "info-continent": "Kontinent",
                "info-urls": "URLs:",
                "no-url": "Keine spezifische URL verfügbar",
                "legend-active": "RBTC aktiv",
                "legend-preparing": "In Vorbereitung RBTC",
                "about-title": "Zweck",
                "about-text": "Der Zweck dieser Website ist es zu zeigen, wo RBTC aktiv ist und direkte Links zu den jeweiligen Online-Präsenzen der Länder bereitzustellen.",
                "footer": "© 2025 RBTC International Schools Map. Alle Rechte vorbehalten.",
                "error-loading": "Fehler beim Laden der Daten"
            },
            en: { // Englische Übersetzungen
                "title": "RBTC Schools Map",
                "nav-home": "Home",
                "nav-map": "Map",
                "nav-about": "About",
                "welcome": "Welcome to RBTC",
                "intro": "Kenneth E. Hagin is the author of 110 books, which have been translated into many languages. With its radio program, RHEMA USA reaches out to more than 100 nations.",
                "foundation": "Foundation: As Brother Hagin traveled in ministry, many times he would cry out to God in the night, \"How can I get this message out to Your people?\" It began to dawn on him that he needed to train people to go and teach the Bible's message.",
                "graduates": "Since 1975 over 40,000 students have graduated from RBTC USA.",
                "presence": "RBTC is active on multiple continents, showcasing its presence in various countries:",
                "americas": "Americas: 0 countries",
                "eame": "EAME (Europe, Africa, Middle East): 0 countries",
                "asia": "Asia/Oceania: 0 countries",
                "filter-continent": "Continent:",
                "filter-country": "Country:",
                "filter-all": "All",
                "filter-preparing": "Show RBTC in preparation:",
                "info-continent": "Continent",
                "info-urls": "URLs:",
                "no-url": "No specific URL available",
                "legend-active": "RBTC active",
                "legend-preparing": "RBTC in preparation",
                "about-title": "About",
                "about-text": "The purpose of this website is to showcase where RBTC is active and provide direct links to the respective countries' online presence.",
                "footer": "© 2025 RBTC International Schools Map. All rights reserved.",
                "error-loading": "Error loading data"
            }
        };

        // Funktion zur Normalisierung von Ländernamen, um Abweichungen zwischen Datensätzen zu berücksichtigen.
        function normalizeCountryName(name) {
            const nameMap = {
                'United States': 'United States of America',
                'China': 'People\'s Republic of China',
                'Dem. Rep. Congo': 'Democratic Republic of the Congo',
                'Congo': 'Republic of the Congo',
                'Czech Republic': 'Czechia',
                'Macedonia': 'North Macedonia',
                'Swaziland': 'Eswatini',
                'Burma': 'Myanmar'
            };
            return nameMap[name] || name; // Gibt den normalisierten Namen zurück oder den ursprünglichen Namen, falls keine Entsprechung gefunden wird.
        }

        // Funktion zum Parsen von CSV-Daten.
        function parseCSV(csv) {
            const lines = csv.split('\n'); // Teilt den CSV-Text in Zeilen.
            const headers = lines[0].split(','); // Nimmt die erste Zeile als Header und teilt sie nach Kommas.
            return lines.slice(1).map(line => { // Verarbeitet alle Zeilen außer dem Header.
                const values = line.match(/(".*?"|[^",]+)(?=\s*,|\s*$)/g) || []; // Extrahiert die Werte aus jeder Zeile, berücksichtigt auch Werte in Anführungszeichen.
                return headers.reduce((obj, header, index) => { // Reduziert die Werte zu einem Objekt, wobei die Header als Schlüssel dienen.
                    let value = values[index] || ''; // Holt den Wert für den aktuellen Header oder einen leeren String, falls kein Wert vorhanden ist.
                    if (value.startsWith('"') && value.endsWith('"')) {
                        value = value.slice(1, -1); // Entfernt die Anführungszeichen am Anfang und Ende des Wertes.
                    }
                    value = value.trim(); // Entfernt Leerzeichen am Anfang und Ende des Wertes.
                    // Mappt deutsche Farbnamen zu englischen für die Weiterverarbeitung.
                    if (header.trim() === 'color') {
                        if (value === 'rot') value = 'red';
                        else if (value === 'gelb') value = 'yellow';
                    }
                    obj[header.trim()] = value; // Fügt das Schlüssel-Wert-Paar dem Objekt hinzu.
                    return obj;
                }, {});
            }).filter(item => Object.keys(item).length > 0); // Filtert leere Zeilen heraus.
        }

        // Asynchrone Funktion zum Laden der Länderdaten aus der CSV-Datei.
        async function loadCountriesData() {
            try {
                document.getElementById('loadingIndicator').style.display = 'block'; // Zeigt den Ladeindikator an.
                const response = await fetch('rbtc_countries.csv'); // Sendet eine Anfrage zum Laden der CSV-Datei.
                if (!response.ok) throw new Error('Network response was not ok'); // Wirft einen Fehler, wenn die Antwort nicht erfolgreich ist.
                const csvText = await response.text(); // Liest den Antworttext als CSV-Daten.
                rbtcCountriesData = parseCSV(csvText); // Parsed die CSV-Daten in ein Array von Objekten.
                console.log(rbtcCountriesData); // Gibt die geladenen Daten in der Konsole aus (für Debugging).
                updateCountryCounts(); // Aktualisiert die Länderzählungen auf der Startseite.
                return true; // Gibt true zurück, wenn das Laden erfolgreich war.
            } catch (error) {
                console.error('Error loading countries data:', error); // Gibt einen Fehler in der Konsole aus, falls ein Problem auftritt.
                alert(translations[currentLanguage]['error-loading']); // Zeigt eine Fehlermeldung für den Benutzer an (in der aktuellen Sprache).
                return false; // Gibt false zurück, wenn das Laden fehlgeschlagen ist.
            } finally {
                document.getElementById('loadingIndicator').style.display = 'none'; // Versteckt den Ladeindikator, unabhängig davon, ob das Laden erfolgreich war oder nicht.
            }
        }

        // Funktion zum Aktualisieren der Länderzählungen auf der Startseite basierend auf den geladenen Daten.
        function updateCountryCounts() {
            const counts = {
                'Americas': 0,
                'EAME': 0,
                'Asia/Oceania': 0
            };

            rbtcCountriesData.forEach(country => {
                if (country.color === "red") { // Zählt nur Länder, die als "aktiv" (rot) markiert sind.
                    counts[country.continent]++;
                }
            });

            // Aktualisiert die Übersetzungen für die Länderzählungen in beiden Sprachen.
            translations.de.americas = `Amerika: ${counts['Americas']} Länder`;
            translations.de.eame = `EAME (Europa, Afrika, Naher Osten): ${counts['EAME']} Länder`;
            translations.de.asia = `Asien/Ozeanien: ${counts['Asia/Oceania']} Länder`;

            translations.en.americas = `Americas: ${counts['Americas']} countries`;
            translations.en.eame = `EAME (Europe, Africa, Middle East): ${counts['EAME']} countries`;
            translations.en.asia = `Asia/Oceania: ${counts['Asia/Oceania']} countries`;

            // Aktualisiert die Textinhalte der entsprechenden HTML-Elemente auf der Seite.
            document.querySelector('[data-i18n="americas"]').textContent = translations[currentLanguage].americas;
            document.querySelector('[data-i18n="eame"]').textContent = translations[currentLanguage].eame;
            document.querySelector('[data-i18n="asia"]').textContent = translations[currentLanguage].asia;
        }

        // Funktion zum Umschalten der Sprache.
        function toggleLanguage() {
            currentLanguage = currentLanguage === 'de' ? 'en' : 'de'; // Ändert die aktuelle Sprache.
            document.documentElement.lang = currentLanguage; // Aktualisiert das 'lang'-Attribut des HTML-Elements.
            updateUILanguage(); // Ruft die Funktion zum Aktualisieren der Benutzeroberfläche auf.
        }

        // Funktion zum Aktualisieren der Benutzeroberfläche basierend auf der ausgewählten Sprache.
        function updateUILanguage() {
            document.querySelectorAll('[data-i18n]').forEach(element => { // Selektiert alle Elemente mit dem Attribut 'data-i18n'.
                const key = element.getAttribute('data-i18n'); // Holt den Wert des 'data-i18n'-Attributs (den Übersetzungsschlüssel).
                const translation = translations[currentLanguage][key]; // Holt die entsprechende Übersetzung aus dem 'translations'-Objekt.
                if (translation) { // Überprüft, ob eine Übersetzung für den Schlüssel in der aktuellen Sprache vorhanden ist.
                    if (element.tagName === 'INPUT' && element.type === 'text') {
                        element.placeholder = translation; // Setzt den Platzhalter für Eingabefelder.
                    } else if (translation.includes('<a')) {
                        element.innerHTML = translation; // Setzt den HTML-Inhalt, falls die Übersetzung HTML-Elemente enthält (z.B. Links).
                    } else {
                        element.textContent = translation; // Setzt den Textinhalt des Elements.
                    }
                }
            });

            // Aktualisiert den Text der Info-Box-URL-Anzeige, falls dieser gerade angezeigt wird.
            const urlsContainer = document.getElementById('countryUrls');
            if (urlsContainer.textContent === translations[currentLanguage === 'de' ? 'en' : 'de']['no-url']) {
                urlsContainer.textContent = translations[currentLanguage]['no-url'];
            }

            updateCountryCounts(); // Aktualisiert die Länderzählungen nach dem Sprachwechsel.
            updateCountryFilter(); // Aktualisiert die Länderliste im Filter nach dem Sprachwechsel.
        }

        // Initialisiert die Leaflet-Karte.
        const map = L.map('map', {
            minZoom: 2, // Minimale Zoomstufe.
            maxZoom: 8, // Maximale Zoomstufe.
            center: [20, 0], // Startposition der Karte (Breitengrad, Längengrad).
            zoom: 2, // Start-Zoomstufe.
            worldCopyJump: true, // Ermöglicht das Springen über die Datumsgrenze.
            maxBounds: [[-90, -180], [90, 180]] // Begrenzt die Karte auf die globalen Koordinaten.
        });

        // Fügt der Karte eine Tile-Layer hinzu (die eigentlichen Kartenbilder).
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors', // Copyright-Hinweis für OpenStreetMap.
            maxZoom: 18 // Maximale Zoomstufe für die Tile-Layer.
        }).addTo(map);

        // Asynchrone Funktion zum Laden der GeoJSON-Daten für die Weltkarte.
        async function loadGeoJSONData() {
            try {
                console.log('Loading GeoJSON data...');
                const response = await fetch('https://d2ad6b4ur7yvpq.cloudfront.net/naturalearth-3.3.0/ne_110m_admin_0_countries.geojson'); // Lädt die GeoJSON-Datei von einer externen Quelle.
                if (!response.ok) throw new Error('Network response was not ok');
                geoJsonData = await response.json(); // Parsed die Antwort als JSON-Daten.
                console.log('GeoJSON data loaded successfully');
                updateMap(); // Ruft die Funktion zum Aktualisieren der Karte auf, nachdem die Daten geladen wurden.
            } catch (error) {
                console.error('Error loading GeoJSON data:', error);
                alert(translations[currentLanguage]['error-loading']); // Zeigt eine Fehlermeldung an, falls das Laden fehlschlägt.
            }
        }

function updateMap() {
    if (!geoJsonData) return; // Beendet die Funktion, wenn die GeoJSON-Daten noch nicht geladen wurden.
    if (geoJsonLayer) map.removeLayer(geoJsonLayer); // Entfernt das vorherige GeoJSON-Layer, falls vorhanden.

    const continentFilter = document.getElementById('continentFilter').value; // Holt den Wert des Kontinentfilters.
    const countryFilter = document.getElementById('countryFilter').value; // Holt den Wert des Länderfilters.
    const showYellow = document.getElementById('showYellow').checked; // Holt den Zustand der "Gelb anzeigen"-Checkbox.

    geoJsonLayer = L.geoJSON(geoJsonData, { // Erstellt ein neues GeoJSON-Layer.
        filter: feature => { // Definiert eine Filterfunktion, um zu bestimmen, welche Features angezeigt werden sollen.
            const normalizedName = normalizeCountryName(feature.properties.name); // Normalisiert den Ländernamen aus den GeoJSON-Daten.

            // Einzelnes Land basierend auf Länderfilter
            if (countryFilter !== 'all') {
                return normalizedName === countryFilter; // Zeigt nur das ausgewählte Land, wenn ein Land im Filter ausgewählt ist.
            }

            // Sonst nach Kontinent und Farbstatus filtern
            const country = rbtcCountriesData.find(c => c.name === normalizedName); // Sucht die entsprechenden RBTC-Daten für das aktuelle Land.

            if (!country) return false; // Wenn kein RBTC-Datensatz für das Land gefunden wird, wird es nicht angezeigt.

            // Filter nach Kontinent
            if (continentFilter !== 'all' && country.continent !== continentFilter) {
                return false; // Wenn ein Kontinentfilter aktiv ist und der Kontinent des Landes nicht übereinstimmt, wird es nicht angezeigt.
            }

            // Filter nach Farbe (gelb = in Vorbereitung)
            if (country.color === 'yellow' && !showYellow) {
                return false; // Wenn die "Gelb anzeigen"-Checkbox nicht aktiviert ist und das Land gelb ist, wird es nicht angezeigt.
            }

            return true; // Das Land erfüllt alle Filterkriterien und wird angezeigt.
        },
        style: feature => { // Definiert eine Style-Funktion, um die Darstellung jedes Features anzupassen.
            const normalizedName = normalizeCountryName(feature.properties.name);
            const country = rbtcCountriesData.find(c => c.name === normalizedName);

            if (country) {
                if (country.color === 'yellow') {
                    return { fillColor: '#ffff99', weight: 2, opacity: 1, color: 'gray', fillOpacity: 0.7 }; // Gelbe Farbe für Länder in Vorbereitung.
                } else if (country.color === 'red') {
                    return { fillColor: '#ffcccc', weight: 2, opacity: 1, color: 'gray', fillOpacity: 0.7 }; // Rote Farbe für aktive RBTC-Länder.
                }
            }

            return { fillColor: 'transparent', weight: 2, opacity: 1, color: 'gray', fillOpacity: 0.7 }; // Standardmäßig transparente Füllung.
        },
        onEachFeature: (feature, layer) => { // Definiert eine Funktion, die für jedes erstellte Feature aufgerufen wird.
            const normalizedName = normalizeCountryName(feature.properties.name);
            const rbtcCountry = rbtcCountriesData.find(c => c.name === normalizedName);

            if (rbtcCountry) {
                layer.on('click', () => showInfo(rbtcCountry)); // Fügt einen Event-Listener hinzu, der beim Klicken auf ein Land die 'showInfo'-Funktion aufruft.
                layer.on('mouseover', () => layer.setStyle({ weight: 3, color: '#666' })); // Ändert den Stil beim Überfahren mit der Maus.
                layer.on('mouseout', () => geoJsonLayer.resetStyle(layer)); // Setzt den ursprünglichen Stil zurück, wenn die Maus das Land verlässt.
            }
        }
    }).addTo(map); // Fügt das GeoJSON-Layer zur Karte hinzu.

    // Setzt die Kartenansicht zurück, wenn keine Filter aktiv sind.
    if (countryFilter === 'all' && continentFilter === 'all') {
        map.setView([20, 0], 2);
    }
}

        // Funktion, die aufgerufen wird, wenn sich ein Filter ändert.
        function filterMap() {
            updateCountryFilter(); // Aktualisiert die Liste der angezeigten Länder im Länderfilter.
            updateMap(); // Aktualisiert die Karte basierend auf den aktuellen Filterkriterien.
        }

        // Funktion zum Aktualisieren des Länderfilters basierend auf dem ausgewählten Kontinent und der "Gelb anzeigen"-Checkbox.
        function updateCountryFilter() {
    const continentFilter = document.getElementById('continentFilter').value; // Holt den Wert des Kontinentfilters.
    const showYellow = document.getElementById('showYellow').checked; // Holt den Zustand der "Gelb anzeigen"-Checkbox.
    const countrySelect = document.getElementById('countryFilter'); // Holt das Länder-Auswahlfeld.
    const currentValue = countrySelect.value; // Speichert den aktuell ausgewählten Wert des Länderfilters.

    countrySelect.innerHTML = `<option value="all">${translations[currentLanguage]['filter-all']}</option>`; // Setzt die Optionen des Länderfilters auf die Standardoption "Alle" zurück (in der aktuellen Sprache).

    // Filtert die Länderdaten basierend auf dem ausgewählten Kontinent und ob gelbe Länder angezeigt werden sollen.
    const filteredCountries = rbtcCountriesData
       .filter(country => {
            // Überprüft, ob der Kontinent des Landes mit dem ausgewählten Filter übereinstimmt oder ob "Alle" ausgewählt ist.
            const continentMatch = continentFilter === 'all' || country.continent === continentFilter;

            // Überprüft, ob gelbe Länder angezeigt werden sollen oder ob das Land nicht gelb ist.
            const colorMatch = showYellow || country.color !== 'yellow';

            return continentMatch && colorMatch; // Gibt nur Länder zurück, die beide Bedingungen erfüllen.
        })
       .sort((a, b) => a.name.localeCompare(b.name)); // Sortiert die gefilterten Länder alphabetisch.

    // Fügt die gefilterten Länder als Optionen zum Länder-Auswahlfeld hinzu.
    filteredCountries.forEach(country => {
        const option = document.createElement('option');
        option.value = country.name;
        option.textContent = country.name;
        countrySelect.appendChild(option);
    });

    // Versucht, den zuvor ausgewählten Wert im Länderfilter wiederherzustellen, falls er in der gefilterten Liste vorhanden ist.
    if (filteredCountries.some(c => c.name === currentValue)) {
        countrySelect.value = currentValue;
    }
}

        // Funktion zum Anzeigen der Info-Box für ein ausgewähltes Land.
        function showInfo(country) {
            const infoBox = document.getElementById('infoBox'); // Holt das Info-Box-Element.
            document.getElementById('countryName').textContent = country.name; // Setzt den Namen des Landes in der Info-Box.
            document.getElementById('continent').textContent = country.continent; // Setzt den Kontinent des Landes in der Info-Box.
            const urlsContainer = document.getElementById('countryUrls'); // Holt den Container für die URLs.
            urlsContainer.innerHTML = ''; // Leert den vorherigen Inhalt des URL-Containers.

            // Überprüft, ob URLs für das Land vorhanden sind.
            if (country.url && country.url.trim()) {
                const urls = country.url.split(',').map(url => url.trim()); // Teilt die URLs (durch Komma getrennt) und entfernt Leerzeichen.
                urls.forEach(url => { // Für jede URL wird ein Link-Element erstellt.
                    const link = document.createElement('a');
                    link.href = url.startsWith('http') ? url : `https://${url}`; // Fügt 'https://' hinzu, falls die URL nicht damit beginnt.
                    link.textContent = url; // Setzt den Text des Links auf die URL.
                    link.target = '_blank'; // Öffnet den Link in einem neuen Tab.
                    link.rel = 'noopener noreferrer'; // Fügt Sicherheitsattribute hinzu.
                    urlsContainer.appendChild(link); // Fügt den Link zum URL-Container hinzu.
                });
            } else {
                urlsContainer.textContent = translations[currentLanguage]['no-url']; // Zeigt eine Meldung an, wenn keine URL vorhanden ist.
            }
            infoBox.style.display = 'block'; // Zeigt die Info-Box an.
        }

        // Schließt die Info-Box, wenn außerhalb geklickt wird.
        document.addEventListener('click', function(e) {
            const infoBox = document.getElementById('infoBox');
            // Überprüft, ob die Info-Box sichtbar ist und ob das geklickte Element nicht innerhalb der Info-Box oder der Karte liegt.
            if (infoBox.style.display === 'block' && !infoBox.contains(e.target) && !e.target.closest('.leaflet-container')) {
                infoBox.style.display = 'none'; // Versteckt die Info-Box.
            }
        });

        // Funktion zum Anzeigen eines bestimmten Inhaltsbereichs (Home, Karte, Über).
        function showSection(sectionId) {
            document.querySelectorAll('.home-section,.map-section,.about-section').forEach(section => {
                section.classList.remove('active'); // Entfernt die 'active'-Klasse von allen Inhaltsbereichen.
            });
            document.getElementById(sectionId).classList.add('active'); // Fügt die 'active'-Klasse dem ausgewählten Bereich hinzu, um ihn anzuzeigen.

            // Wenn der Kartenbereich angezeigt wird, wird die Größe der Karte neu berechnet, um sicherzustellen, dass sie korrekt dargestellt wird.
            if (sectionId === 'map-section') {
                setTimeout(() => {
                    map.invalidateSize(); // Informiert Leaflet, dass sich die Größe des Karten-Containers geändert hat.
                    updateMap(); // Stellt sicher, dass die Karte mit den aktuellen Daten und Filtern angezeigt wird.
                }, 100); // Ein kurzer Timeout kann helfen, wenn die Anzeige des Bereichs animiert ist.
            }
        }

        // Hauptinitialisierungsfunktion, die beim Laden der Seite aufgerufen wird.
        async function initialize() {
            const dataLoaded = await loadCountriesData(); // Lädt die Länderdaten und wartet, bis sie geladen sind.
            if (dataLoaded) { // Wenn die Länderdaten erfolgreich geladen wurden.
                await loadGeoJSONData(); // Lädt die GeoJSON-Daten und wartet, bis sie geladen sind.
                updateUILanguage(); // Aktualisiert die Benutzeroberfläche auf die Standardsprache (Deutsch).
                updateCountryFilter(); // Initialisiert den Länderfilter.
                showSection('home'); // Zeigt standardmäßig den Home-Bereich an.
            }
        }

        // Wartet, bis das gesamte DOM geladen ist, bevor die Initialisierungsfunktion aufgerufen wird.
        document.addEventListener('DOMContentLoaded', initialize);
    </script>
